{
  agents: {
    defaults: {
      model: { primary: "foundry-npu/foundry-npu" },
      timeoutSeconds: 300,
      maxConcurrent: 1,
      subagents: {
        maxConcurrent: 1
      },
      memorySearch: { provider: "none" },
      models: {
        "foundry-npu/foundry-npu": {
          alias: "Foundry NPU via LiteLLM"
        }
      }
    }
  },
  tools: {
    profile: "minimal",
    allow: null,
    alsoAllow: ["bundle-mcp", "group:plugins", "snapdragon-npu__*"],
    codeMode: {
      enabled: false
    }
  },
  models: {
    mode: "merge",
    providers: {
      "foundry-npu": {
        baseUrl: "http://127.0.0.1:4001/v1",
        apiKey: "sk-win-vivo2",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "foundry-npu",
            name: "Foundry NPU Qwen 2.5 7B via LiteLLM",
            reasoning: false,
            input: ["text"],
            cost: {
              input: 0,
              output: 0,
              cacheRead: 0,
              cacheWrite: 0
            },
              contextWindow: 28672,
              contextTokens: 22000,
              maxTokens: 96
          }
        ]
      }
    }
  }
}
